@model Template.Web.Features.StanzeStudio.StanzeStudioViewModel
@{
    ViewData["Title"] = "Stanze di Studio";
}

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
        min-height: 38px;
    }
</style>

<div id="app-lobby" class="container py-4" v-cloak>
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Stanze di Studio</h1>
            <p class="text-secondary mb-0">Collabora e studia in tempo reale con altri studenti usando il metodo Pomodoro</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill shadow-sm px-4 py-2" @@click="checkCreateRoom">
                <i class="fa-solid fa-plus me-2"></i>Crea Nuova Stanza
            </button>
        </div>
    </div>

    <!-- Feedback messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-xmark me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filters -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <!form @@submit.prevent class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" v-model="searchTerm" class="form-control bg-light border-start-0" placeholder="Cerca per nome stanza o materia..." />
                </div>
            </div>
            <div class="col-md-5">
                <select v-model="selectedCorsoId" class="form-select bg-light">
                    <option value="">Tutte le materie</option>
                    @foreach (var corso in Model.Corsi)
                    {
                        <option value="@corso.Id">@corso.Nome</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" @@click="searchTerm = ''; selectedCorsoId = '';" class="btn btn-outline-secondary rounded-3"><i class="fa-solid fa-filter-circle-xmark me-2"></i>Reset</button>
            </div>
        </!form>
    </div>

    <!-- Rooms List Grid -->
    <div v-if="filteredStanze.length === 0" class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
        <div class="py-4">
            <i class="fa-solid fa-ghost fs-1 text-muted mb-3 opacity-50"></i>
            <h5 class="fw-bold text-dark">Nessuna stanza trovata</h5>
            <p class="text-secondary max-w-md mx-auto">Non ci sono stanze di studio attive per i criteri di ricerca impostati. Crea una nuova stanza per iniziare!</p>
            <button class="btn btn-primary rounded-pill shadow-sm px-4 mt-2" @@click="checkCreateRoom">
                <i class="fa-solid fa-plus me-2"></i>Crea la prima stanza
            </button>
        </div>
    </div>
    <div v-else class="row g-4">
        <div v-for="stanza in filteredStanze" :key="stanza.id" class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 d-flex flex-column position-relative transition-all hover-translate-y">
                <!-- Upper Section -->
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-primary-light text-primary rounded-pill px-2.5 py-1 fs-8 fw-semibold mb-2">{{ stanza.corsoNome }}</span>
                        <h5 class="fw-bold text-dark mb-0">
                            <i v-if="stanza.isPrivate" class="fa-solid fa-lock text-warning me-1 fs-7" title="Stanza privata"></i>{{ stanza.nome }}
                        </h5>
                    </div>
                    <span class="badge rounded-pill px-2.5 py-1 fs-9 fw-semibold" :class="stanza.isTimerRunning ? 'bg-success-light text-success' : 'bg-warning-light text-warning'">
                        <i class="fa-solid fa-circle me-1 fs-10"></i>{{ stanza.isTimerRunning ? (stanza.isBreak ? 'Pausa' : 'Studio') : 'In Pausa' }}
                    </span>
                </div>

                <!-- Description -->
                <p class="text-secondary small mb-3 text-truncate-2" :title="stanza.descrizione || 'Nessun argomento specificato.'">
                    {{ stanza.descrizione || 'Nessun argomento specificato per questa sessione di studio.' }}
                </p>

                <!-- Info Grid -->
                <div class="my-3 py-2 border-top border-bottom border-light">
                    <div class="row text-center">
                        <div class="col-6 border-end border-light">
                            <span class="text-muted small d-block">Membri</span>
                            <span class="fw-bold text-dark"><i class="fa-solid fa-users text-primary me-1"></i>{{ stanza.onlineCount }}/{{ stanza.maxCapacity }}</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Pomodoro</span>
                            <span class="fw-bold text-dark"><i class="fa-regular fa-clock text-warning me-1"></i>{{ formatTime(stanza.remainingSeconds) }}</span>
                        </div>
                    </div>
                </div>

                <!-- Footer / Actions -->
                <div class="mt-auto pt-3">
                    <button type="button" @@click="enterRoom(stanza)" class="btn btn-primary w-100 rounded-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                        Entra nella Stanza <i class="fa-solid fa-right-to-bracket ms-2 fs-7"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Room Modal -->
<div class="modal fade" id="createRoomModal" tabindex="-1" aria-labelledby="createRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createRoomModalLabel">Crea Stanza di Studio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("Create", "StanzeStudio")" autocomplete="off">
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label for="roomName" class="form-label fw-semibold small text-dark">Nome della Stanza</label>
                        <input type="text" class="form-control rounded-3" id="roomName" name="name" placeholder="Es. Aula Studio Analisi 1, Pomodoro Chimica" required />
                    </div>
                    <div class="mb-3">
                        <label for="corsoSelect" class="form-label fw-semibold small text-dark">Materia di riferimento</label>
                        <select class="form-select rounded-3" id="corsoSelect" name="corsoId" required>
                            @foreach (var corso in Model.Corsi)
                            {
                                <option value="@corso.Id">@corso.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="roomDescription" class="form-label fw-semibold small text-dark">Descrizione / Argomenti di studio</label>
                        <textarea class="form-control rounded-3" id="roomDescription" name="description" rows="2" placeholder="Es. Preparazione esame, ripasso capitolo 4, risoluzione esercizi..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="timerSelect" class="form-label fw-semibold small text-dark">Durata sessione Pomodoro (Minuti)</label>
                        <select class="form-select rounded-3" id="timerSelect" name="durationMinutes">
                            <option value="25">25 minuti (Classico)</option>
                            <option value="50">50 minuti (Lungo)</option>
                            <option value="15">15 minuti (Short)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="maxCapacity" class="form-label fw-semibold small text-dark">Massimo Partecipanti</label>
                        <input type="number" class="form-control rounded-3" id="maxCapacity" name="maxCapacity" value="8" min="2" max="20" required />
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isPrivateCheck" onchange="document.getElementById('passwordField').style.display = this.checked ? 'block' : 'none';">
                            <label class="form-check-label fw-semibold small text-dark" for="isPrivateCheck">
                                <i class="fa-solid fa-lock me-1 text-warning"></i> Stanza Privata (protetta da password)
                            </label>
                        </div>
                    </div>
                    <div class="mb-3" id="passwordField" style="display:none;">
                        <label for="roomPassword" class="form-label fw-semibold small text-dark">Password della Stanza</label>
                        <input type="text" class="form-control rounded-3" id="roomPassword" name="password" placeholder="Inserisci una password per la stanza" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Crea ed Entra</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <!-- SignalR client library -->
    <script src="~/js/bundle-signalr.js"></script>
    <script src="~/js/bundle-vue.js"></script>
    <script>
        const initialStanze = @Html.Raw(Json.Serialize(Model.Stanze.Select(s => new {
            id = s.Id,
            nome = s.Nome,
            corsoNome = s.CorsoNome,
            corsoId = s.CorsoId.ToString(),
            onlineCount = s.OnlineCount,
            maxCapacity = s.MaxCapacity,
            remainingSeconds = (int)s.TempoRimanente.TotalSeconds,
            isTimerRunning = s.IsInEsecuzione,
            isBreak = false,
            isPrivate = s.IsPrivate,
            descrizione = s.Descrizione
        })));

        new Vue({
            el: '#app-lobby',
            data: {
                stanze: initialStanze,
                searchTerm: '',
                selectedCorsoId: '',
                connection: null
            },
            computed: {
                filteredStanze() {
                    return this.stanze.filter(s => {
                        const matchSearch = !this.searchTerm.trim() || 
                            s.nome.toLowerCase().includes(this.searchTerm.toLowerCase()) || 
                            s.corsoNome.toLowerCase().includes(this.searchTerm.toLowerCase());
                        const matchCorso = !this.selectedCorsoId || s.corsoId === this.selectedCorsoId;
                        return matchSearch && matchCorso;
                    });
                }
            },
            methods: {
                initSignalR() {
                    this.connection = new signalR.HubConnectionBuilder()
                        .withUrl('/templateHub')
                        .withAutomaticReconnect()
                        .configureLogging(signalR.LogLevel.Error)
                        .build();

                    this.connection.on('LobbyRoomUpdated', (roomId, nome, corsoNome, corsoId, onlineCount, remainingSeconds, isRunning, isBreak, descrizione) => {
                        let room = this.stanze.find(s => s.id === roomId);
                        if (room) {
                            room.onlineCount = onlineCount;
                            room.remainingSeconds = remainingSeconds;
                            room.isTimerRunning = isRunning;
                            room.isBreak = isBreak;
                            room.descrizione = descrizione;
                        } else {
                            this.stanze.push({
                                id: roomId,
                                nome: nome,
                                corsoNome: corsoNome,
                                corsoId: corsoId,
                                onlineCount: onlineCount,
                                maxCapacity: 8,
                                remainingSeconds: remainingSeconds,
                                isTimerRunning: isRunning,
                                isBreak: isBreak,
                                descrizione: descrizione
                            });
                        }
                    });

                    this.connection.start()
                        .then(() => {
                            console.log("SignalR connected to Hub from Lobby");
                            this.connection.invoke('JoinLobby')
                                .catch(err => console.error("Error joining lobby:", err));
                        })
                        .catch(err => console.error("SignalR Connection Error in Lobby:", err));
                },
                formatTime(seconds) {
                    const mins = Math.floor(seconds / 60);
                    const secs = seconds % 60;
                    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                },
                enterRoom(stanza) {
                    const activeRoomId = sessionStorage.getItem('activeRoomId');
                    if (activeRoomId && activeRoomId !== stanza.id) {
                        alert("Sei già all'interno di un'altra stanza di studio. Per favore, esci dalla stanza corrente prima di accedere ad una nuova.");
                        return;
                    }
                    window.location.href = '/StanzeStudio/Room/' + stanza.id;
                },
                checkCreateRoom() {
                    const activeRoomId = sessionStorage.getItem('activeRoomId');
                    if (activeRoomId) {
                        alert("Sei già all'interno di una stanza di studio. Per favore, esci dalla stanza corrente prima di crearne una nuova.");
                        return;
                    }
                    const modalEl = document.getElementById('createRoomModal');
                    if (modalEl) {
                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                }
            },
            mounted() {
                this.initSignalR();

                // Periodic countdown interval for running timers
                setInterval(() => {
                    this.stanze.forEach(s => {
                        if (s.isTimerRunning && s.remainingSeconds > 0) {
                            s.remainingSeconds--;
                        }
                    });
                }, 1000);
            },
            beforeDestroy() {
                if (this.connection) {
                    this.connection.invoke('LeaveLobby')
                        .catch(err => console.error(err));
                }
            }
        });
    </script>
}
