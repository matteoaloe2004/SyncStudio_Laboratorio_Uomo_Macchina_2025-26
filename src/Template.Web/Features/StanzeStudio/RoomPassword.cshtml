@{
    ViewData["Title"] = "Accesso Stanza Protetta";
    var roomId = ViewData["RoomId"];
    var roomName = ViewData["RoomName"];
    var corsoName = ViewData["CorsoName"];
    var wrongPassword = ViewData["WrongPassword"] as bool? ?? false;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 text-center">
                <div class="mb-4">
                    <div class="mx-auto rounded-circle bg-warning-light d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="fa-solid fa-lock fs-3 text-warning"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Stanza Protetta</h4>
                    <p class="text-secondary small mb-0">
                        <strong>@roomName</strong> • @corsoName
                    </p>
                </div>

                <p class="text-muted small mb-3">Questa stanza è privata. Inserisci la password per accedere.</p>

                @if (wrongPassword)
                {
                    <div class="alert alert-danger rounded-3 py-2 fs-7 mb-3" role="alert">
                        <i class="fa-solid fa-circle-xmark me-1"></i> Password errata. Riprova.
                    </div>
                }

                <form method="get" action="@Url.Action("Room", "StanzeStudio")" autocomplete="off">
                    <input type="hidden" name="id" value="@roomId" />
                    <div class="mb-3">
                        <input type="password" class="form-control rounded-3 text-center py-2.5" name="pwd" placeholder="Password della stanza" required autofocus />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold py-2.5 shadow-sm">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Entra nella Stanza
                    </button>
                </form>

                <a href="/StanzeStudio" class="btn btn-link text-muted small mt-3 text-decoration-none">
                    <i class="fa-solid fa-arrow-left me-1"></i> Torna alle Stanze
                </a>
            </div>
        </div>
    </div>
</div>
