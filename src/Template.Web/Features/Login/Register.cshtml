@model Template.Web.Features.Login.RegisterViewModel
@{
    ViewData["Title"] = "Registrati a StudySync";
    Layout = "_LayoutHtml"; // We use LayoutHtml to bypass the main Layout which includes the top nav
}

<div class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="auth-card p-4 p-sm-5 shadow-sm rounded-4 bg-white border-0">
        <div class="text-center mb-4">
            <div class="auth-logo-circle d-inline-flex align-items-center justify-content-center mb-3 bg-success">
                <i class="fa-solid fa-user-plus text-white fs-4"></i>
            </div>
            <h2 class="auth-title fw-bold text-dark mb-1">Crea Account</h2>
            <p class="text-muted small">Registrati per unirti alle aule studio e scaricare appunti</p>
        </div>

        <form method="post" role="form" autocomplete="off" class="needs-validation">
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Indirizzo Email</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-transparent text-muted"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="nome@esempio.it" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NickName" class="form-label small fw-semibold text-secondary">Nickname</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-transparent text-muted"><i class="fa-solid fa-at"></i></span>
                    <input asp-for="NickName" class="form-control border-start-0 ps-0" placeholder="Scegli un nickname" required />
                </div>
                <span asp-validation-for="NickName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label asp-for="FirstName" class="form-label small fw-semibold text-secondary">Nome</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Mario" required />
                    <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-6">
                    <label asp-for="LastName" class="form-label small fw-semibold text-secondary">Cognome</label>
                    <input asp-for="LastName" class="form-control" placeholder="Rossi" required />
                    <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-transparent text-muted"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Crea una password" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Conferma Password</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 bg-transparent text-muted"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Ripeti la password" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger small p-2 border-0 rounded-3 mb-4" role="alert">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-semibold shadow-sm transition-all text-white">Registrati</button>

            <div class="text-center mt-4">
                <p class="small text-secondary mb-0">Hai già un account? <a href="@Url.Action(MVC.Login.Login())" class="text-primary fw-semibold text-decoration-none">Accedi</a></p>
            </div>
        </form>
    </div>
</div>
