@section scripts{
    <script type="text/javascript">
        @this.RenderAlertsWithToastify()
    </script>

    <script type="text/javascript">
        (function () {
            document.addEventListener("DOMContentLoaded", function () {
                const path = window.location.pathname.toLowerCase();
                const isInRoomPage = path.includes('/stanzestudio/room');
                const activeRoomId = sessionStorage.getItem('activeRoomId');
                
                // If we are on the room page, don't show the minimized floating widget
                if (isInRoomPage) {
                    return;
                }

                if (!activeRoomId) {
                    return;
                }

                const roomName = sessionStorage.getItem('activeRoomName') || 'Stanza Studio';
                const roomCorso = sessionStorage.getItem('activeRoomCorso') || 'Materia';
                const userNickname = sessionStorage.getItem('userNickname') || 'Studente';

                // Show widget
                const widget = document.getElementById('studysync-minimized-room');
                const nameEl = document.getElementById('studysync-minimized-name');
                const statusEl = document.getElementById('studysync-minimized-status');
                const timerTextEl = document.getElementById('studysync-minimized-timer-text');
                const timerRingEl = document.getElementById('studysync-minimized-timer');
                const badgeEl = document.getElementById('studysync-minimized-badge');

                if (widget) {
                    widget.style.display = 'flex';
                    nameEl.textContent = roomName;
                    statusEl.textContent = roomCorso;
                }

                let unreadCount = 0;
                let timerInterval = null;
                let isRunning = false;
                let remainingSeconds = 0;
                let isBreak = false;

                // Connect to SignalR
                if (typeof signalR !== 'undefined') {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/templateHub")
                        .build();

                    connection.on("TimerUpdated", (running, seconds, breakMode) => {
                        isRunning = running;
                        remainingSeconds = seconds;
                        isBreak = breakMode;

                        updateTimerUI();
                        startLocalTimer();
                    });

                    connection.on("ReceiveChatMessage", (user, text, time) => {
                        if (user !== userNickname) {
                            unreadCount++;
                            badgeEl.textContent = unreadCount;
                            badgeEl.style.display = 'flex';
                        }
                    });

                    connection.start()
                        .then(() => {
                            connection.invoke("JoinRoom", activeRoomId, userNickname);
                        })
                        .catch(err => console.error("Error starting SignalR in minimized widget:", err));

                    // Leave Room Action
                    const leaveBtn = document.getElementById('studysync-minimized-leave');
                    const modal = document.getElementById('studysync-leave-modal');
                    const cancelBtn = document.getElementById('studysync-modal-cancel');
                    const confirmBtn = document.getElementById('studysync-modal-confirm');

                    if (leaveBtn && modal) {
                        leaveBtn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            modal.style.display = 'flex';
                        });

                        cancelBtn.addEventListener('click', function () {
                            modal.style.display = 'none';
                        });

                        confirmBtn.addEventListener('click', function () {
                            modal.style.display = 'none';
                            connection.invoke("LeaveRoom", activeRoomId, userNickname)
                                .then(() => {
                                    sessionStorage.removeItem('activeRoomId');
                                    sessionStorage.removeItem('activeRoomName');
                                    sessionStorage.removeItem('activeRoomCorso');
                                    sessionStorage.removeItem('userNickname');
                                    widget.style.display = 'none';
                                    connection.stop();
                                })
                                .catch(err => console.error(err));
                        });
                    }
                }

                function updateTimerUI() {
                    const mins = Math.floor(remainingSeconds / 60);
                    const secs = remainingSeconds % 60;
                    timerTextEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                    
                    if (isBreak) {
                        timerRingEl.classList.add('is-break');
                    } else {
                        timerRingEl.classList.remove('is-break');
                    }
                }

                function startLocalTimer() {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }

                    if (isRunning) {
                        timerInterval = setInterval(() => {
                            if (remainingSeconds > 0) {
                                remainingSeconds--;
                                updateTimerUI();
                            } else {
                                clearInterval(timerInterval);
                                timerInterval = null;
                            }
                        }, 1000);
                    }
                }
            });
        })();
    </script>

    <script type="text/javascript">
        (function () {
            document.addEventListener("DOMContentLoaded", function () {
                const isLoggedIn = @(identitaCorrente != null ? "true" : "false");
                if (!isLoggedIn) return;

                if (typeof signalR !== 'undefined') {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/templateHub")
                        .build();

                    window.appHubConnection = connection;

                    connection.on("ReceiveNotification", function(message) {
                        Toastify({
                            text: message,
                            duration: 7000,
                            gravity: "top",
                            position: "right",
                            close: true,
                            style: {
                                background: "linear-gradient(to right, #ea580c, #f97316)",
                                borderRadius: "10px",
                                padding: "12px 20px",
                                boxShadow: "0 10px 15px -3px rgba(0,0,0,0.1)"
                            }
                        }).showToast();
                    });

                    connection.start()
                        .then(() => {
                            console.log("Global SignalR Connection established.");
                        })
                        .catch(err => console.error("Error starting global SignalR connection:", err));

                    // Fetch unread notifications on page load
                    fetch('/Notifiche/GetUnreadNotifiche')
                        .then(res => res.json())
                        .then(data => {
                            if (data.success && data.notifiche.length > 0) {
                                data.notifiche.forEach((n, idx) => {
                                    setTimeout(() => {
                                        Toastify({
                                            text: n.messaggio,
                                            duration: 8000,
                                            gravity: "top",
                                            position: "right",
                                            close: true,
                                            style: {
                                                background: "linear-gradient(to right, #ea580c, #f97316)",
                                                borderRadius: "10px",
                                                padding: "12px 20px"
                                            }
                                        }).showToast();
                                        
                                        // Mark as read
                                        const formData = new FormData();
                                        formData.append('id', n.id);
                                        fetch('/Notifiche/MarkAsRead', { 
                                            method: 'POST',
                                            body: formData
                                        });
                                    }, idx * 1200);
                                });
                            }
                        })
                        .catch(err => console.error("Error fetching initial notifications:", err));
                }
            });
        })();
    </script>

    @RenderSection("scripts", false)
}