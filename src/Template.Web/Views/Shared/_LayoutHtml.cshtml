<!DOCTYPE html>
<html lang="@this.CurrentCulture().Name" class="@ViewData["FullscreenClass"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - StudySync</title>
    <meta name="description" content="@ViewData["Description"]">
    @RenderSection("googlehead", false)
    @RenderSection("metas", false)
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/node_modules/@@fortawesome/fontawesome-free/css/all.min.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/bundle-global.min.css" asp-append-version="true" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>">
    @RenderSection("styles", false)
</head>
<body>
    @RenderSection("googlebody", false)
    @RenderBody()
    <script type="text/javascript">
        var clientLocale = '@this.CurrentCulture().Name';
    </script>
    <environment include="Development,Docker">
        <script src="~/js/bundle-global.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development,Docker">
        <script src="~/js/bundle-global.min.js" asp-append-version="true"></script>
    </environment>
    <script src="~/js/bundle-signalr.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>